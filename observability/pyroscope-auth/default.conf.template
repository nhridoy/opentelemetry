# Basic-auth proxy in front of Pyroscope (which has no login of its own).
# Rendered by the nginx image's envsubst at start; $host stays as an nginx var.
server {
    listen 80;
    client_max_body_size 20m;  # profile uploads

    location / {
        auth_basic           "Pyroscope";
        auth_basic_user_file /etc/nginx/conf.d/htpasswd;
        proxy_pass           http://pyroscope:4040;
        proxy_http_version   1.1;  # Pyroscope's push API (Connect) expects HTTP/1.1+
        proxy_set_header     Host $host;
    }
}
